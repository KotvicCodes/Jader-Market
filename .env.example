# Synthetic local development settings only. Never reuse this password publicly.
POSTGRES_USER=jader
POSTGRES_PASSWORD=local-demo-only
POSTGRES_DB=jader_market
DATABASE_URL=postgresql://jader:local-demo-only@127.0.0.1:55432/jader_market
NEXT_TELEMETRY_DISABLED=1
# The exact browser origin. Use HTTPS when deploying beyond localhost.
APP_ORIGIN=http://localhost:3000
# admin:create generates and saves this private encryption key in .env.
# Keep the generated key with your private database backups.
AUTH_SECRET=
# Only needed for integration tests; this must be a dedicated disposable database.
TEST_DATABASE_URL=postgresql://jader:local-demo-only@127.0.0.1:55432/jader_market_test

# Production only: one client IP from a trusted proxy that overwrites this header.
# Restrict app networking so users cannot bypass the proxy. Local dev needs no proxy.
AUTH_TRUSTED_IP_HEADER=
