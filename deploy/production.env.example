# Copy outside the checkout to /etc/jader-market/production.env, mode 0600.
# Generate different strong URL-safe passwords. This file contains no usable secrets.
JADER_HOST=market.example.org
JADER_IMAGE=jader-market:0.1.13
JADER_BOOTSTRAP_PASSWORD=
JADER_OWNER_PASSWORD=
JADER_RUNTIME_PASSWORD=
JADER_OWNER_DATABASE_URL=postgresql://jader_owner:REPLACE@db:5432/jader_market
JADER_RUNTIME_DATABASE_URL=postgresql://jader_runtime:REPLACE@db:5432/jader_market
AUTH_SECRET=
JADER_TLS_DIRECTORY=/etc/jader-market/tls
