{
  "name": "jader-market",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.1 <23",
    "npm": ">=11.21.0 <12"
  },
  "scripts": {
    "dev": "node scripts/run.mjs next dev --hostname 0.0.0.0",
    "build": "node scripts/run.mjs next build",
    "start": "node scripts/run.mjs next start --hostname 0.0.0.0",
    "typecheck": "node scripts/run.mjs tsc --noEmit",
    "lint": "node scripts/run.mjs eslint . --max-warnings=0",
    "test": "node scripts/run.mjs vitest run",
    "test:integration": "node scripts/run.mjs vitest run --config vitest.integration.config.ts",
    "test:http": "node scripts/run.mjs tsx scripts/test-members-http.ts",
    "db:generate": "node scripts/run.mjs drizzle-kit generate",
    "db:migrate": "node scripts/run.mjs tsx scripts/migrate.ts",
    "db:seed": "node scripts/run.mjs tsx scripts/seed.ts",
    "admin:create": "node scripts/run.mjs tsx scripts/admin.ts",
    "admin:recover": "node scripts/run.mjs tsx scripts/admin.ts --recover",
    "worker": "node scripts/run.mjs tsx scripts/worker.ts",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "dotenv": "18.0.5",
    "drizzle-orm": "0.45.3",
    "next": "16.4.0",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.3",
    "fast-glob": "npm:tinyglobby@0.2.15"
  },
  "overrides": {
    "fast-glob": "$fast-glob",
    "esbuild": "0.28.2"
  },
  "packageManager": "npm@11.21.0",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
